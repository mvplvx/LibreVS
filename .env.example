# Copy to .env for local development:
#   cp .env.example .env

# PostgreSQL (required)
DATABASE_URL=postgresql://librevs:librevs@localhost:5432/librevs?schema=public

# Structured stdout logs (1 = on, 0 = off)
LIBREVS_LOG=1

# Pilot / release exposure (optional)
LIBREVS_PILOT_MODE=1
NEXT_PUBLIC_LIBREVS_PILOT_MODE=true

# Optional: short git commit in footer and /api/librevs/version
# LIBREVS_GIT_SHA=abc1234

# Production Compose reads these names from this directory's .env file.
# Generate passwords with: openssl rand -base64 24
# POSTGRES_PASSWORD=
# POSTGRES_USER=librevs
# POSTGRES_DB=librevs
# LIBREVS_HTTP_PORT=3000
# Leave LIBREVS_TRUSTED_PROXIES empty unless a reverse proxy replaces X-Forwarded-For.
# VS2026_EDITOR_ENABLED=true

# Development seed is not run by the production container.

# Authentication. Generate the secret with: openssl rand -base64 32
# Do not commit the generated value. Public sign-up is disabled.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated proxy IPs or CIDRs. Leave empty unless a reverse
# proxy overwrites X-Forwarded-For from the connecting address. An empty value
# disables IP tracking so a client cannot choose the rate-limit key.
# LIBREVS_TRUSTED_PROXIES=

# Authenticated VS 2026 diagnostic preview. Disabled unless set to the exact value true.
# Restart the Next.js process after changing it. The caller is the signed-in session.
# VS2026_PREVIEW_ENABLED=true

# Authenticated VS 2026 Basic Module editor. Disabled unless set to the exact value true.
# Independent of the preview flag. Restart the Next.js process after changing it.
# VS2026_EDITOR_ENABLED=true
