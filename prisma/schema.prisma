generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  companies Company[]
  feedback  VsmeFeedback[]
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String?
  country            String?
  industry           String?
  /** Drives B/C applicability (workflow + export validation). */
  employeeCount      Int?
  /** EU reporting currency (display/export metadata only — no FX). */
  currency           String   @default("EUR")
  createdAt          DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  reportingPeriods ReportingPeriod[]
}

model ReportingPeriod {
  id        String    @id @default(cuid())
  year      Int
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("draft")
  /** VSME registry version active when the period was created. */
  schemaVersion String @default("2.0.0")

  /**
   * Explicit VS 2026 reporting option for this period.
   * Null means the period is not configured. It is not Option A.
   * The running VSME scope does not read this column.
   */
  vs2026ReportingOption String?
  /**
   * Paragraph 25 Comprehensive disclosure ids for Option A.
   * Empty when the period is not configured or the option is Option B.
   */
  vs2026AdditionalComprehensiveDisclosures String[] @default([])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  sustainabilityDataPoints SustainabilityDataPoint[]
  fieldMateriality       VsmeFieldMateriality[]
  exportSnapshots        VsmeExportSnapshot[]
  vs2026RepeatingRows    Vs2026RepeatingRow[]

  createdAt DateTime @default(now())
}

/** Immutable EFRAG export capture for audit and version history. */
model VsmeExportSnapshot {
  id String @id @default(cuid())

  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)

  companyId String

  createdAt DateTime @default(now())

  stateSnapshot      Json
  exportData         Json
  validationResult   Json

  reportingState String
  coverage       Float

  isFinal Boolean @default(false)
  version Int

  @@unique([reportingPeriodId, version])
  @@index([reportingPeriodId])
  @@index([companyId])
}

/** Per-field materiality assessment (material vs non_material) for a reporting period. */
model VsmeFieldMateriality {
  id String @id @default(cuid())

  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)

  fieldId String
  /** "material" | "non_material" */
  materiality String @default("material")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([reportingPeriodId, fieldId])
}

model SustainabilityDataPoint {
  id String @id @default(cuid())

  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  fieldId String
  value   String
  unit    String?

  /** Original v1 fieldId when row predates v2 registry (preserved for audit). */
  legacyFieldId   String?
  /** v2 registry fieldId when a known v1 id was mapped (fieldId may still hold v1). */
  migratedFieldId String?
  /** v1→v2 migration outcome; null for native v2 rows. */
  migrationStatus String?

  createdAt DateTime @default(now())

  @@unique([reportingPeriodId, fieldId])
}

/**
 * One stable VS 2026 repeating-fact row.
 * Unused by the running workspace, APIs, and exports.
 * `position` is display order. The id is the identity.
 * `parentRowId` names a B1 site for B5 and B6. It does not copy the site.
 * The parent foreign key includes `reportingPeriodId`, so a child can name a
 * parent only inside its own reporting period. It does not check `groupId`.
 */
model Vs2026RepeatingRow {
  id                String   @id @default(cuid())
  reportingPeriodId String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  groupId           String
  parentRowId       String?
  parentRow         Vs2026RepeatingRow?  @relation("Vs2026RepeatingParent", fields: [parentRowId, reportingPeriodId], references: [id, reportingPeriodId], onDelete: NoAction)
  childRows         Vs2026RepeatingRow[] @relation("Vs2026RepeatingParent")
  position          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  values            Vs2026RepeatingValue[]

  @@unique([id, reportingPeriodId])
  @@index([reportingPeriodId, groupId, position])
  @@index([parentRowId])
}

/**
 * One cell on a repeating row.
 * `dimensionMember` is empty when the fact has no dimension.
 * A missing cell is the absence of a row, not the string "0".
 */
model Vs2026RepeatingValue {
  id              String   @id @default(cuid())
  rowId           String
  row             Vs2026RepeatingRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  datapointId     String
  dimensionMember String   @default("")
  value           String
  unit            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([rowId, datapointId, dimensionMember])
}

/** Phase 6 — in-app feedback capture (no external integrations). */
model VsmeFeedback {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reportingPeriodId String?
  fieldId           String?
  section           String?
  message           String

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}
